# === Outputs: default-deny, allowlist only what MOBA reads ===
output/
outputs/

# Allow the clustering manifest tree (per-run figures, manifests, labels, recon CSVs/PNGs)
!02_FBM_Clustering/outputs/
!02_FBM_Clustering/outputs/clustering/
!02_FBM_Clustering/outputs/clustering/**
!02_FBM_Clustering/outputs/colors_config.json
!02_FBM_Clustering/outputs/ReadME.txt

# Allow the fsaverage meshes (and only those, not the rest of 250_recon)
!02_FBM_Clustering/outputs/250_recon/
!02_FBM_Clustering/outputs/250_recon/fsaverage/
!02_FBM_Clustering/outputs/250_recon/fsaverage/**

# Allow the live ERSP_clean PNGs only
!01_FBM_Analysis/outputs/
