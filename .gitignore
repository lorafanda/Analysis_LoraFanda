# === System / editor noise ===
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
*Thumbs.db
*.tif
*.pptx
.claude/

# === Python ===
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
dist/
build/
.env
venv/
.venv/

# === Heavy local artifacts (never push) ===
*.h5
*.joblib
*.npy
*.xlsx
*.xls
*.parquet
*.db
*.pkl

# === Archived / deprecated stuff (never push) ===
x_archive/
**/x_archive/
**/x_archive/**
*_to_delete*
**/*_to_delete*
*Copy*
**/*Copy*
*-SAFE*
**/*-SAFE*
archives/
.jupyter/

# === Outputs: default-deny, allowlist only what MOBA reads ===
output/
outputs/

# Allow the clustering manifest tree (per-run figures, manifests, labels, recon CSVs/PNGs)
!02_FBM_Clustering/outputs/
!02_FBM_Clustering/outputs/clustering/
!02_FBM_Clustering/outputs/clustering/**
!02_FBM_Clustering/outputs/colors_config.json
!02_FBM_Clustering/outputs/ReadME.txt

# Canonical dataset cache is large + machine-local — never push
02_FBM_Clustering/outputs/_dataset/

# Allow the classification manifest tree (per-run figures, metrics, confusion matrices)
!03_FBM_Classifying/outputs/
!03_FBM_Classifying/outputs/classification/
!03_FBM_Classifying/outputs/classification/**
# Classification dataset/feature cache is large + machine-local — never push
03_FBM_Classifying/outputs/_dataset/
# feature_importance.csv explodes for parcellation runs (300 features → 5 MB+ each);
# regenerable from the run, never push. The broad classification allowlist above
# force-includes them, so re-deny explicitly here. (Keeps the small _by_band/_by_time variants.)
03_FBM_Classifying/outputs/classification/**/feature_importance.csv

# Allow the pooling manifest tree (overlays, pool/anatomy run artifacts) — NOT renders
!04_FBM_Pooling/outputs/
!04_FBM_Pooling/outputs/pooling/
!04_FBM_Pooling/outputs/pooling/**
# Renders are regenerable + heavy; pool.html plots fsaverage via Niivue from the
# coord export, so these PNGs are never needed in git. Re-deny after the allow above.
# Need the /** form (not just the dir): !pooling/** above force-included every file,
# so a directory-only re-deny is overridden — /** re-denies the files themselves.
04_FBM_Pooling/outputs/pooling/**/renders/
04_FBM_Pooling/outputs/pooling/**/renders/**
# Heavy/regenerable BINARIES inside the pooling allowlist: the !pooling/** above
# force-includes them, overriding the global *.parquet/*.npy ignores, so re-deny here.
# (Keeps pool_web/*.csv + *.json — what the website reads — committable.)
04_FBM_Pooling/outputs/pooling/**/*.parquet
04_FBM_Pooling/outputs/pooling/**/*.npy
04_FBM_Pooling/outputs/pooling/**/*.joblib
04_FBM_Pooling/outputs/pooling/**/*.pkl
# Pooling dataset cache + machine-local MNE aparc build — never push
04_FBM_Pooling/outputs/_dataset/
04_FBM_Pooling/outputs/_anatomy/
# renders are regenerable + heavy; pool.html plots fsaverage via Niivue from the export, not these PNGs
04_FBM_Pooling/outputs/pooling/**/renders/


# Allow the fsaverage meshes (and only those, not the rest of 250_recon)
!02_FBM_Clustering/outputs/250_recon/
!02_FBM_Clustering/outputs/250_recon/fsaverage/
!02_FBM_Clustering/outputs/250_recon/fsaverage/**

# Allow the live ERSP_clean + alternate view PNGs (ERSP_blob, ERSP_minus101)
!01_FBM_Analysis/outputs/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_clean/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_clean/**
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_blob/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_blob/**
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_minus101/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_minus101/**
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_hg/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_hg/**
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_rawds/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_rawds/**

# Inside the live ERSP tree, re-deny the heavy / unused siblings
01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_matrix/
