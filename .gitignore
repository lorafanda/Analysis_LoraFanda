02_FBM_Clustering/outputs/clustering/**/df_keep_with_clusters.parquet
02_FBM_Clustering/outputs/clustering/**/blob_artifacts/keep_idx.npy
02_FBM_Clustering/outputs/clustering/**/blob_artifacts/blobs_per_sample.joblib
02_FBM_Clustering/outputs/clustering/**/blob_artifacts/ersp_keep.npy

# Re-deny legacy / old ERSP siblings + clustering siblings if anyone tries to re-add them
01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY_old/
01_FBM_Analysis/outputs/04_ersp_LM/
01_FBM_Analysis/outputs/04_ersp_segmented/
01_FBM_Analysis/outputs/11_MicroMacro_results/
