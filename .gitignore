*Copy*
**/*Copy*
*-SAFE*
**/*-SAFE*
archives/
.jupyter/

# === Outputs: default-deny, allowlist only what MOBA reads ===
output/
outputs/

# Allow the clustering manifest tree (per-run figures, manifests, labels, recon CSVs/PNGs)
!02_FBM_Clustering/outputs/
!02_FBM_Clustering/outputs/clustering/
!02_FBM_Clustering/outputs/clustering/**
!02_FBM_Clustering/outputs/colors_config.json
!02_FBM_Clustering/outputs/ReadME.txt

# Allow the fsaverage meshes (and only those, not the rest of 250_recon)
!02_FBM_Clustering/outputs/250_recon/
!02_FBM_Clustering/outputs/250_recon/fsaverage/
!02_FBM_Clustering/outputs/250_recon/fsaverage/**

# Allow the live ERSP_clean + alternate view PNGs (ERSP_blob, ERSP_minus101)
!01_FBM_Analysis/outputs/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_clean/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_clean/**
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_blob/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_blob/**
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_minus101/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_minus101/**
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_hg/
!01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_hg/**

# Inside the live ERSP tree, re-deny the heavy / unused siblings
01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/ERSP_matrix/
01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/PSD_raw/
01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/PSD_clean/
01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/Report/
01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY/**/manifest/

# Inside the clustering tree, re-deny per-run heavy local artifacts.
# The earlier `*.npy / *.joblib / *.parquet` ignores get overridden by the
# broad `!02_FBM_Clustering/outputs/clustering/**` re-include above, so we
# have to name the offenders explicitly inside the clustering allowlist.
02_FBM_Clustering/outputs/clustering/**/X_train.npy
02_FBM_Clustering/outputs/clustering/**/linkage_Z.npy
02_FBM_Clustering/outputs/clustering/**/distance_D.npy
02_FBM_Clustering/outputs/clustering/**/model.joblib
02_FBM_Clustering/outputs/clustering/**/predictor.joblib
02_FBM_Clustering/outputs/clustering/**/scaler.joblib
02_FBM_Clustering/outputs/clustering/**/df_keep_with_clusters.parquet
02_FBM_Clustering/outputs/clustering/**/blob_artifacts/keep_idx.npy
02_FBM_Clustering/outputs/clustering/**/blob_artifacts/blobs_per_sample.joblib
02_FBM_Clustering/outputs/clustering/**/blob_artifacts/ersp_keep.npy

# Re-deny legacy / old ERSP siblings + clustering siblings if anyone tries to re-add them
01_FBM_Analysis/outputs/04_ersp_LM_RAWONLY_old/
01_FBM_Analysis/outputs/04_ersp_LM/
01_FBM_Analysis/outputs/04_ersp_segmented/
01_FBM_Analysis/outputs/11_MicroMacro_results/
02_FBM_Clustering/outputs/logs/
02_FBM_Clustering/outputs/230_blob_clustering_runs/
02_FBM_Clustering/outputs/231_minus101_clustering_runs/
02_FBM_Clustering/outputs/250_recon/clustering_recon/
02_FBM_Clustering/outputs/250_recon/talairach/
02_FBM_Clustering/outputs/250_recon/PAT_*/
02_FBM_Clustering/outputs/250_recon/EL*/

# === Last-line catch-all: Thumbs.db anywhere, even inside allowlisted trees ===
